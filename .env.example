# Copy to .env and fill in:   cp .env.example .env
# .env is in .gitignore. Never share or commit this file.

# Your bot's token from @BotFather (looks like 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat ID (a number). Only this chat gets alerts and can use commands.
# Don't know it? Leave empty, start the bot, send /start to it - it replies with your ID.
TELEGRAM_CHAT_ID=

# Timezone for logs (the daily summary uses `timezone` in config.yaml)
TZ=UTC

# 1 = print messages to the log instead of sending them
DRY_RUN=0
LOG_LEVEL=INFO

# Private status page (optional). Leave STATUS_PAGE_TOKEN empty to keep it off.
# Telegram alerts keep working either way. The token is the password in the link:
#   http://<umbrel-lan-ip>:8787/s/<STATUS_PAGE_TOKEN>
# Generate one with:  openssl rand -hex 16
# Do not port-forward this port.
# STATUS_PAGE_TOKEN=
# STATUS_PAGE_PORT=8787
# STATUS_PAGE_BIND=0.0.0.0

# Phone push (optional). Leave NTFY_TOPIC empty to keep it off.
# Telegram keeps working either way. The topic is a password for the ntfy app.
# Generate one with:  openssl rand -hex 16
# Alerts go to https://ntfy.sh over HTTPS. No account and no payment.
# The phone text does not include miner LAN addresses, wallets, or this token.
# NTFY_TOPIC=
# NTFY_URL=https://ntfy.sh

# Confirmed payout blocks (optional). Leave BLOCK_WATCH empty to keep it off.
# Compares a block's coinbase with your public payout address on YOUR node.
# The address is not sent to a website. Do not put a seed or a private key here.
# This does not say which miner found the block. A best share is not a block.
# BTC_NODE_RPC_URL=http://127.0.0.1:8332
# BTC_NODE_RPC_USER=
# BTC_NODE_RPC_PASSWORD=
# BTC_PAYOUT_ADDRESSES=YOUR-BTC-PAYOUT-ADDRESS
# BCH only if you run your own Bitcoin Cash node (not solopool.org):
# BCH_NODE_RPC_URL=
# BCH_NODE_RPC_USER=
# BCH_NODE_RPC_PASSWORD=
# BCH_PAYOUT_ADDRESSES=YOUR-BCH-PAYOUT-ADDRESS
# BLOCK_WATCH=
