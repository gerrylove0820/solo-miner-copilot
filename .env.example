# Copy to .env and fill in:   cp .env.example .env
# .env is in .gitignore. Never share or commit this file.

# Your bot's token from @BotFather (looks like 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat ID (a number). Only this chat gets alerts and can use commands.
# Don't know it? Leave empty, start the bot, send /start to it - it replies with your ID.
TELEGRAM_CHAT_ID=

# Timezone for logs (the daily summary uses `timezone` in config.yaml)
TZ=UTC

# 1 = print messages to the log instead of sending them
DRY_RUN=0
LOG_LEVEL=INFO
